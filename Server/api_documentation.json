{
  "openapi": "3.1.0",
  "info": {
    "title": "🏛️ SIH 2026 Tender Management & GeM ML Intelligence Platform - Full API Specification",
    "description": "Complete consolidated OpenAPI 3.1 REST API specification for the SIH 2026 Platform. Encompasses Bidder Authentication, Officer Authentication, DigiLocker Verification, Cloudinary Tender Document Storage, and the complete 13-Endpoint GeM ML Microservice v2.0.0 suite.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Spring Boot Server"
    },
    {
      "url": "https://sih2026-83r4.onrender.com",
      "description": "Production Render Backend Server"
    },
    {
      "url": "http://20.40.44.184",
      "description": "Production GeM Python ML Microservice (v2.0.0)"
    }
  ],
  "tags": [
    {
      "name": "1. Bidder Authentication",
      "description": "Bidder Registration, Government Record Pre-Validation, Email OTP, and JWT Authentication."
    },
    {
      "name": "2. Bidder Management",
      "description": "Bidder Profile Retrieval, Update, and Management."
    },
    {
      "name": "3. Officer Authentication & DigiLocker",
      "description": "Officer Login, JWT Session Verification, and DigiLocker / MeriPehchaan OAuth Flow."
    },
    {
      "name": "4. Tender Management & Cloudinary",
      "description": "Tender Document Upload, Cloudinary Secure Storage, and Bidder Evaluation."
    },
    {
      "name": "5. GeM ML v2.0.0 Master Endpoints",
      "description": "13 Production ML Endpoints: OCR, pyHanko Signatures, Live GSTIN/PAN Verification, Autonomous Audits, RAG Dossier, and Model Inference."
    }
  ],
  "paths": {
    "/api/bidder/auth/signup": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Initiate Bidder Signup & Verify Against Government Records",
        "description": "Checks database for duplicate email/GST, validates legalName and GSTIN against government records, creates a temporary session, and dispatches an OTP via Brevo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "legalName": "Arnav Tyagi",
                "email": "arnav24169006@gmail.com",
                "gstNumber": "09ARNAV9012H3Z7",
                "phone": "9876500103",
                "password": "Password@123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup initiated, temporary token generated, and OTP sent to email",
            "content": {
              "application/json": {
                "example": {
                  "tempToken": "93162d76aa9141d8950d9e7905ab3d5c",
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "message": "Bidder verified successfully against government records! Verification OTP sent to arnav24169006@gmail.com"
                }
              }
            }
          },
          "409": { "description": "Email or GSTIN is already registered" },
          "400": { "description": "Invalid credentials or mismatch with government record" }
        }
      }
    },
    "/api/bidder/auth/verify-otp": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Verify Email OTP & Finalize Registration",
        "description": "Validates the 6-digit OTP, creates the permanent Bidder entity in PostgreSQL, and generates a JWT Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "arnav24169006@gmail.com",
                "otp": "123456",
                "tempToken": "93162d76aa9141d8950d9e7905ab3d5c"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bidder account created and verified successfully",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiJ9...",
                  "type": "Bearer",
                  "bidderId": 1,
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "phone": "9876500103",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "isVerified": true,
                  "message": "Registration completed successfully! Bidder account created and verified."
                }
              }
            }
          },
          "400": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/api/bidder/auth/resend-otp": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Resend Verification OTP",
        "description": "Generates and sends a new 6-digit verification OTP to the bidder's email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "arnav24169006@gmail.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fresh OTP dispatched successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "A fresh OTP has been sent to arnav24169006@gmail.com"
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder/auth/login": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Bidder Login",
        "description": "Authenticates verified bidder and issues a 24-hour JWT Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "arnav24169006@gmail.com",
                "password": "Password@123"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT token" },
          "401": { "description": "Invalid email or password" },
          "403": { "description": "Account not verified" }
        }
      }
    },
    "/api/bidder/auth/me": {
      "get": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Get Current Authenticated Bidder Profile",
        "description": "Retrieves the full profile and verification status of the currently authenticated bidder.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile retrieved successfully" },
          "401": { "description": "Unauthorized: Missing or invalid Bearer token" }
        }
      }
    },
    "/api/bidder/auth/verify-token": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Verify JWT or Temporary Registration Token",
        "description": "Validates token passed in Authorization header, request body, or query param."
      }
    },
    "/api/bidder/auth/forgot-password": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Initiate Forgot Password",
        "description": "Sends a password reset OTP to the bidder's registered email."
      }
    },
    "/api/bidder/auth/verify-forgot-password-otp": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Verify Password Reset OTP",
        "description": "Validates the reset OTP and generates a secure resetToken."
      }
    },
    "/api/bidder/auth/reset-password": {
      "post": {
        "tags": ["1. Bidder Authentication"],
        "summary": "Reset Password",
        "description": "Updates bidder's password using the verified resetToken."
      }
    },
    "/api/bidders": {
      "get": {
        "tags": ["2. Bidder Management"],
        "summary": "Get All Bidders",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/bidders/{id}": {
      "get": {
        "tags": ["2. Bidder Management"],
        "summary": "Get Bidder By ID",
        "security": [{ "bearerAuth": [] }]
      },
      "put": {
        "tags": ["2. Bidder Management"],
        "summary": "Update Bidder Profile",
        "security": [{ "bearerAuth": [] }]
      },
      "delete": {
        "tags": ["2. Bidder Management"],
        "summary": "Delete Bidder",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/officer/auth/login": {
      "post": {
        "tags": ["3. Officer Authentication & DigiLocker"],
        "summary": "Officer Login",
        "description": "Authenticate an officer using Employee ID / Email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "officer@pwd.gov.in",
                "password": "Password@123"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT Bearer token" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/officer/auth/verify-token": {
      "post": {
        "tags": ["3. Officer Authentication & DigiLocker"],
        "summary": "Verify Officer JWT Token"
      }
    },
    "/api/officer/auth/digilocker/initiate": {
      "get": {
        "tags": ["3. Officer Authentication & DigiLocker"],
        "summary": "Initiate DigiLocker OAuth Verification",
        "description": "Generates DigiLocker MeriPehchaan OAuth authorization URL."
      }
    },
    "/api/officer/auth/digilocker/callback": {
      "get": {
        "tags": ["3. Officer Authentication & DigiLocker"],
        "summary": "DigiLocker OAuth Callback",
        "description": "Exchanges OAuth code for access token and retrieves verified government employee profile."
      }
    },
    "/api/officer/tenders/upload": {
      "post": {
        "tags": ["4. Tender Management & Cloudinary"],
        "summary": "Upload & Process Tender Document",
        "description": "Uploads tender PDF/Image to Cloudinary, forwards to GeM ML Service for OCR, Layout, and Classification, and saves metadata into PostgreSQL.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "documentType": { "type": "string", "default": "other" }
                },
                "required": ["file", "title"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Tender document uploaded and analyzed successfully" }
        }
      }
    },
    "/api/officer/tenders": {
      "get": {
        "tags": ["4. Tender Management & Cloudinary"],
        "summary": "Get All Tenders for Authenticated Officer",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/officer/tenders/{id}": {
      "get": {
        "tags": ["4. Tender Management & Cloudinary"],
        "summary": "Get Tender Details & ML Intelligence by ID",
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/officer/tenders/{id}/compare-bidders": {
      "post": {
        "tags": ["4. Tender Management & Cloudinary"],
        "summary": "Compare Bidders Against Tender Requirements",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "bidders_data": [
                  { "bidder_id": 1, "bidder_name": "L&T Construction", "bid_amount": 142000000, "experience_years": 15, "financial_rating": "AAA" },
                  { "bidder_id": 2, "bidder_name": "Afcons Infra", "bid_amount": 148000000, "experience_years": 12, "financial_rating": "AA+" }
                ],
                "tender_requirements": { "max_budget": 150000000, "min_experience_years": 10 }
              }
            }
          }
        }
      }
    },
    "/api/officer/tenders/ml-health": {
      "get": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "1. Unified Health & Live GST Portal Connectivity Check (GET /health)",
        "description": "Returns operational health of gem-ml-service v2.0.0 and live connectivity to services.gst.gov.in."
      }
    },
    "/api/officer/tenders/document-types": {
      "get": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "2. Procurement Document Taxonomy & Weights (GET /api/ml/document-types)",
        "description": "Master taxonomy of all 18 Indian procurement document categories and dynamic CIS weights."
      }
    },
    "/api/officer/tenders/ml/process-document": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "3. Single-File Consolidated Intake (POST /api/ml/process-document)",
        "description": "Consolidated single-call intake (OCR + Layout + Classification + NER + Forgery)."
      }
    },
    "/api/officer/tenders/ml/automate-all": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "4. Master Autonomous Tender Audit - JSON Intake (POST /api/ml/automate-all)",
        "description": "Autonomous multi-document tender audit with GFR 173(i) MSME/Startup statutory exemptions and ML verdict."
      }
    },
    "/api/officer/tenders/ml/automate-all-files": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "5. Master Batch Multipart File Audit (POST /api/ml/automate-all-files)",
        "description": "Autonomous tender audit accepting batch multipart uploads of bidder documents and tender NIT."
      }
    },
    "/api/officer/tenders/ml/overall-summary": {
      "get": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "6. Consolidated Comprehensive Dossier & RAG Synthesis (GET /api/ml/overall-summary)",
        "description": "Single merged JSON dossier combining all ML, statutory, forensic, & RAG markdown chunks."
      }
    },
    "/api/officer/tenders/ml/verify-document": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "7. Unified Forensic Verification & Anti-Tampering (POST /api/ml/verify-document)",
        "description": "pyHanko CCA digital signatures, QR codes, OpenCV rubber stamps, and card tampering analysis. Accepts Multipart File or JSON."
      }
    },
    "/api/officer/tenders/ml/verify-taxpayer": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "8. Unified Statutory Taxpayer Verification (POST /api/ml/verify-taxpayer)",
        "description": "Validates GSTIN, PAN, and UIN format, Mod-36 checksum, and live portal lookup."
      }
    },
    "/api/officer/tenders/ml/tender-requirements": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "9. Dynamic Tender Requirements & Checklist (POST /api/ml/tender-requirements)",
        "description": "Parses NIT and BQC clauses with GFR 173(i) MSME waivers and 6-pillar cover checklist."
      }
    },
    "/api/officer/tenders/ml/process-clearance": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "10. Procurement Clearance Decision Engine (POST /api/ml/process-clearance)",
        "description": "Single-click executive clearance decision based on CIS score and ML verdict."
      }
    },
    "/api/officer/tenders/ml/compliance-predict": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "11. Direct ML Compliance Verdict & Score Predictor (POST /api/ml/compliance/predict)",
        "description": "Direct inference using trained AutomatedComplianceScorer (Random Forest Classifier + Regressor)."
      }
    },
    "/api/officer/tenders/ml/train-all": {
      "post": {
        "tags": ["5. GeM ML v2.0.0 Master Endpoints"],
        "summary": "12. Unified ML Retraining Pipeline (POST /api/ml/train/all)",
        "description": "Retrains Document Classifier, Forgery Detector, and Compliance Scorer with hot reloading."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
