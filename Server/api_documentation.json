    "/api/ai/tender/process": {
      "post": {
        "tags": ["6. Node AI RAG & Gemini Chatbot Service"],
        "summary": "Ingest Tender PDF into Vector Embeddings (768 Dimensions)",
        "description": "Downloads Tender PDF, breaks text into semantic chunks, generates Google Gemini text-embedding-004 vector embeddings, and saves into PostgreSQL pgvector table tender_embeddings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "tenderId": "6",
                "title": "Construction of High-Speed Flyover Corridor - GeM/2026/B/9633946",
                "pdfUrl": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
                "publicId": "tenders/file_ovy8ga"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tender indexed successfully into pgvector",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Tender processed successfully",
                  "data": {
                    "tenderId": "6",
                    "title": "Construction of High-Speed Flyover Corridor - GeM/2026/B/9633946",
                    "totalChunks": 1,
                    "savedChunks": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/bidder/process": {
      "post": {
        "tags": ["6. Node AI RAG & Gemini Chatbot Service"],
        "summary": "Ingest Bidder Document into Vector Embeddings",
        "description": "Parses Bidder PDF (e.g. GST certificate, Balance Sheet), generates dense Gemini vector embeddings, and saves to bidder_embeddings table tagged with bidderId and documentType.",
        "requestBody": {
          "required": true,
