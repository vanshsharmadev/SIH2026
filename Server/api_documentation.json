{
  "openapi": "3.0.3",
  "info": {
    "title": "Tender Management Platform API Specification",
    "version": "2.0.0",
    "description": "Complete and accurate REST API specification for Bidder and Officer authentication, verification, and management."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Spring Boot Server"
    }
  ],
  "tags": [
    { "name": "Bidder Auth", "description": "Bidder signup, government verification, email OTP, token validation, and password reset" },
    { "name": "Bidder Management", "description": "CRUD operations on registered bidder profiles" },
    { "name": "Officer Auth & DigiLocker", "description": "Officer signup, DigiLocker identity verification, email OTP, login, and profile" }
  ],
  "paths": {
    "/api/bidder/auth/signup": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "1. Bidder Signup",
        "description": "Verifies legalName, email, and gstNumber against official government records (bidder_verification table). On match, creates temporary session and sends Brevo Email OTP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["legalName", "email", "gstNumber", "phone", "password"],
                "properties": {
                  "legalName": { "type": "string", "example": "Arnav Tyagi" },
                  "email": { "type": "string", "format": "email", "example": "arnav24169006@gmail.com" },
                  "gstNumber": { "type": "string", "example": "09ARNAV9012H3Z7" },
                  "phone": { "type": "string", "example": "9876500103" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup successful - temporary token created and OTP sent",
            "content": {
              "application/json": {
                "example": {
                  "tempToken": "ca4fb296799c4505a886a689b65ab74a",
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "message": "Bidder verified successfully against government records! Verification OTP sent to arnav24169006@gmail.com"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials or name mismatch with govt records",
            "content": {
              "application/json": {
                "example": {
                  "timestamp": "2026-09-06T15:45:00.000",
                  "status": 400,
                  "error": "Bad Request",
                  "message": "Invalid credentials: Legal name does not match the registered bidder name for this GST/Email."
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder/auth/verify-otp": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "2. Verify Email OTP",
        "description": "Verifies 6-digit email OTP. Creates permanent Bidder record and returns JWT Bearer authentication token. Accepts either email or tempToken.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["otp"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@gmail.com" },
                  "tempToken": { "type": "string", "example": "ca4fb296799c4505a886a689b65ab74a" },
                  "otp": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration completed - JWT token returned",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhcm5hdjI0MTY5MDA2QGdtYWlsLmNvbSIsImlhdCI6MTcyNTYyODAwMCwiZXhwIjoxNzI1NzE0NDAwfQ.example_signature",
                  "type": "Bearer",
                  "bidderId": 1,
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "phone": "9876500103",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "isVerified": true,
                  "message": "Registration completed successfully! Bidder account created and verified."
                }
              }
            }
          },
          "400": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/api/bidder/auth/resend-otp": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "3. Resend OTP",
        "description": "Resends a fresh 6-digit verification OTP to the registered email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@gmail.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP resent successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "A fresh OTP has been sent to arnav24169006@gmail.com"
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder/auth/login": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "4. Bidder Login",
        "description": "Authenticates a verified bidder with email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@gmail.com" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful - returns JWT token",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhcm5hdjI0MTY5MDA2QGdtYWlsLmNvbSIsImlhdCI6MTcyNTYyODAwMCwiZXhwIjoxNzI1NzE0NDAwfQ.example_signature",
                  "type": "Bearer",
                  "bidderId": 1,
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "phone": "9876500103",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "isVerified": true,
                  "message": "Bidder logged in successfully!"
                }
              }
            }
          },
          "401": { "description": "Invalid email or password" }
        }
      }
    },
    "/api/bidder/auth/verify-token": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "5. Verify Token (POST)",
        "description": "Validates a JWT Bearer Auth Token or temporary signup session token (tempToken). Accepts token via Authorization Header, JSON Body, or query parameter.",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Bearer <JWT_TOKEN>" },
          { "name": "token", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": { "type": "string", "example": "ca4fb296799c4505a886a689b65ab74a" },
                  "tempToken": { "type": "string", "example": "ca4fb296799c4505a886a689b65ab74a" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token verification result",
            "content": {
              "application/json": {
                "example": {
                  "valid": true,
                  "tokenType": "JWT",
                  "bidderId": 1,
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "phone": "9876500103",
                  "isVerified": true,
                  "message": "JWT token is valid and active."
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Bidder Auth"],
        "summary": "5. Verify Token (GET)",
        "description": "GET variant to verify token via query param ?token= or Authorization header.",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": false, "schema": { "type": "string" } },
          { "name": "token", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token verification result" }
        }
      }
    },
    "/api/bidder/auth/me": {
      "get": {
        "tags": ["Bidder Auth"],
        "summary": "6. Get Current Authenticated Bidder Profile",
        "description": "Returns profile details of the logged-in bidder.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Bidder profile",
            "content": {
              "application/json": {
                "example": {
                  "valid": true,
                  "tokenType": "JWT",
                  "bidderId": 1,
                  "email": "arnav24169006@gmail.com",
                  "legalName": "Arnav Tyagi",
                  "gstNumber": "09ARNAV9012H3Z7",
                  "phone": "9876500103",
                  "isVerified": true,
                  "message": "Current authenticated bidder profile"
                }
              }
            }
          },
          "401": { "description": "Not authenticated or token expired" }
        }
      }
    },
    "/api/bidder/auth/forgot-password": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "7. Forgot Password",
        "description": "Sends a 6-digit password reset OTP to registered email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@gmail.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset OTP sent",
            "content": {
              "application/json": {
                "example": {
                  "message": "Password reset OTP sent to your registered email."
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder/auth/verify-forgot-password-otp": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "8. Verify Forgot Password OTP",
        "description": "Verifies password reset OTP and generates a resetToken (valid for 10 mins).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@gmail.com" },
                  "otp": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified and resetToken issued",
            "content": {
              "application/json": {
                "example": {
                  "message": "OTP verified successfully.",
                  "resetToken": "4b68e9f546bb4c87893c834bc7721867"
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder/auth/reset-password": {
      "post": {
        "tags": ["Bidder Auth"],
        "summary": "9. Reset Password",
        "description": "Sets a new password using verified resetToken.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["resetToken", "newPassword"],
                "properties": {
                  "resetToken": { "type": "string", "example": "4b68e9f546bb4c87893c834bc7721867" },
                  "newPassword": { "type": "string", "example": "NewPassword@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "message": "Password reset successfully. You can now login with your new password."
                }
              }
            }
          }
        }
      }
    },
    "/api/bidder": {
      "get": {
        "tags": ["Bidder Management"],
        "summary": "Get All Bidders",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "List of registered bidders",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "legalName": "Arnav Tyagi",
                    "email": "arnav24169006@gmail.com",
                    "gstNumber": "09ARNAV9012H3Z7",
                    "phone": "9876500103",
                    "createdAt": "2026-09-06T13:45:00.000"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/bidder/{id}": {
      "get": {
        "tags": ["Bidder Management"],
        "summary": "Get Bidder By ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Bidder profile details" }
        }
      },
      "put": {
        "tags": ["Bidder Management"],
        "summary": "Update Bidder Profile",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string", "example": "9876500103" },
                  "address": { "type": "string", "example": "123 Business Park, Tech Zone, Noida" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated bidder profile" }
        }
      },
      "delete": {
        "tags": ["Bidder Management"],
        "summary": "Delete Bidder Profile",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Bidder profile deleted successfully" }
        }
      }
    },
    "/api/officer/auth/signup": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "1. Officer Signup",
        "description": "Saves pending officer signup details and returns DigiLocker verification URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "mobile", "departmentId", "departmentName", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Itachi Uchiha" },
                  "departmentId": { "type": "integer", "example": 1 },
                  "departmentName": { "type": "string", "example": "Public Works Department" },
                  "email": { "type": "string", "example": "arnav24169006@akgec.ac.in" },
                  "mobile": { "type": "string", "example": "+919876543210" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup initiated with DigiLocker URL",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Signup initiated. Please verify identity via DigiLocker.",
                  "data": {
                    "tempToken": "732054aad4ec4d2390b51e5a2aaaf6c5",
                    "authorizationUrl": "http://localhost:8080/api/officer/identity/mock-login?token=732054aad4ec4d2390b51e5a2aaaf6c5",
                    "message": "Signup details saved. Please complete DigiLocker identity verification to proceed."
                  },
                  "timestamp": "2026-09-06T14:30:00.000"
                }
              }
            }
          }
        }
      }
    },
    "/api/officer/identity/initiate": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "2. Initiate DigiLocker Session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tempToken"],
                "properties": {
                  "tempToken": { "type": "string", "example": "732054aad4ec4d2390b51e5a2aaaf6c5" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "DigiLocker URL re-generated" }
        }
      }
    },
    "/api/officer/identity/mock-verify": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "3. Mock DigiLocker Identity Verify (POST)",
        "description": "Verifies officer name and Aadhaar identity with DigiLocker and automatically sends email OTP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tempToken"],
                "properties": {
                  "tempToken": { "type": "string", "example": "732054aad4ec4d2390b51e5a2aaaf6c5" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identity verified and OTP dispatched to email",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Identity verified successfully",
                  "data": {
                    "identityVerified": true,
                    "identityProvider": "DIGILOCKER_MOCK",
                    "digilockerId": "DL-DEMO-001",
                    "verifiedName": "Itachi Uchiha",
                    "tempToken": "732054aad4ec4d2390b51e5a2aaaf6c5",
                    "identityVerifiedAt": "2026-09-06T14:31:00.000"
                  },
                  "timestamp": "2026-09-06T14:31:00.000"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "3. Mock DigiLocker Identity Verify (GET)",
        "description": "Browser redirect / GET endpoint using query parameter ?token={tempToken}.",
        "parameters": [
          { "name": "token", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Identity verified" }
        }
      }
    },
    "/api/officer/auth/verify-otp": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "4. Verify Officer Email OTP",
        "description": "Verifies 6-digit email OTP, creates permanent Officer account, and returns JWT Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@akgec.ac.in" },
                  "otp": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Officer registration completed",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Email verified successfully! Registration complete.",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "type": "Bearer",
                    "id": 1,
                    "email": "arnav24169006@akgec.ac.in",
                    "name": "Itachi Uchiha",
                    "departmentId": 1,
                    "departmentName": "Public Works Department",
                    "identityVerified": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/officer/auth/resend-otp": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "5. Resend Officer OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "example": "arnav24169006@akgec.ac.in" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP resent successfully" }
        }
      }
    },
    "/api/officer/auth/login": {
      "post": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "6. Officer Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["emailOrMobile", "password"],
                "properties": {
                  "emailOrMobile": { "type": "string", "example": "arnav24169006@akgec.ac.in" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful - returns JWT Bearer token",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Officer authenticated successfully",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "type": "Bearer",
                    "id": 1,
                    "email": "arnav24169006@akgec.ac.in",
                    "name": "Itachi Uchiha",
                    "departmentId": 1,
                    "departmentName": "Public Works Department",
                    "identityVerified": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/officer/auth/me": {
      "get": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "7. Get Current Officer Profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current officer profile" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
