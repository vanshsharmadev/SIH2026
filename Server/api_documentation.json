                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                    "type": "Bearer",
                    "id": 1,
                    "email": "arnav24169006@akgec.ac.in",
                    "name": "Itachi Uchiha",
                    "departmentId": 1,
                    "departmentName": "Public Works Department",
                    "identityVerified": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/officer/auth/me": {
      "get": {
        "tags": ["Officer Auth & DigiLocker"],
        "summary": "7. Get Current Officer Profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current officer profile" }
        }
      }
    },
    "/api/officer/tenders/upload": {
      "post": {
        "tags": ["Officer Tenders & ML AI"],
        "summary": "1. Upload Tender Document & Analyze via ML (Cloudinary + AI)",
        "description": "Uploads Tender PDF to Cloudinary, sends document to Python ML Service (http://20.40.44.184) for OCR, key-value criteria extraction, and authenticity/tamper analysis, and saves to PostgreSQL.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "title"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Tender Document PDF / Image"
                  },
                  "title": {
                    "type": "string",
                    "example": "Construction of High-Speed Flyover Corridor - GeM/2026/B/8912"
                  },
                  "description": {
                    "type": "string",
                    "example": "National highway widening and elevated corridor tender notice."
                  },
                  "documentType": {
                    "type": "string",
                    "example": "other",
                    "description": "udyam_certificate, gst_certificate, pan_card, income_tax_return, oem_authorization, or other"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tender document uploaded to Cloudinary and processed by ML service",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Tender document uploaded and analyzed successfully",
                  "data": {
                    "id": 1,
                    "title": "Construction of High-Speed Flyover Corridor",
                    "description": "National highway widening",
                    "fileName": "tender_rfp_2026.pdf",
                    "fileType": "application/pdf",
                    "fileSize": 1048576,
                    "fileUrl": "https://res.cloudinary.com/tender-portal/image/upload/v1725700000/tenders/tender_rfp_2026.pdf",
