            }
          }
        }
      }
    },
    "/api/ai/bidder-tender-chat/ask": {
      "post": {
        "tags": ["6. Node AI RAG & Gemini Chatbot Service"],
        "summary": "Ask Bidder-Tender Chatbot (Spring Boot Proxy)",
        "description": "Performs cosine similarity vector search in PostgreSQL pgvector, retrieves matching context chunks, and invokes Google Gemini LLM to answer the user query with cited evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "tenderId": "6",
                "bidderId": "3",
                "query": "What are the eligibility criteria and key turnover requirements?"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI analysis and answer with retrieved vector sources",
            "content": {
              "application/json": {
                "example": {
                  "answer": "Based on the provided Tender Requirements, the key eligibility criteria are:\n1. Manufacturer/OEM status on GeM.\n2. Non-MSE bidders must match L-1 price if within L-1 + 15% to receive 25% allocation.\n3. Valid Udyam and GST documentary evidence must be uploaded.",
                  "retrievedContext": {
                    "tender": [
                      {
                        "content": "The bidder must be the manufacturer / OEM of the offered product on GeM...",
                        "score": 0.35,
                        "metadata": { "tenderId": "6", "documentType": "TENDER" }
                      }
                    ]
                  },
                  "tenderId": "6",
                  "bidderId": "3"
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/compare/chat": {
      "post": {
        "tags": ["6. Node AI RAG & Gemini Chatbot Service"],
        "summary": "Multi-Bidder AI Comparison Chatbot (Direct Node API)",
        "description": "Queries pgvector embeddings across multiple bidders simultaneously and uses Gemini 1.5 Pro to generate a comparative tabular evaluation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
