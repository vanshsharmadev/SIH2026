    "/api/bidder/auth/signup": {
      "post": {
        "tags": ["1. Commercial Bidder Authentication"],
        "summary": "Initiate Bidder Signup & Verify Against Government Records (Matches UI)",
        "description": "Receives company & authorized representative details matching the frontend registration UI, verifies duplicate email/GST, checks government records, saves temp session, and sends 6-digit OTP via Brevo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "authorizedPersonName": "Rahul Sharma",
                "companyName": "ABC Technologies Pvt Ltd",
                "email": "arnavtyagibhai@gmail.com",
                "phone": "9876543210",
                "gstNumber": "09ABCDE1234F1Z5",
                "password": "Password123",
                "confirmPassword": "Password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signup initiated, temporary token generated, and OTP sent to registered email",
            "content": {
              "application/json": {
                "example": {
                  "tempToken": "b4e88390b39546279f6dc698f2eb89bc",
                  "email": "arnavtyagibhai@gmail.com",
                  "legalName": "Rahul Sharma",
                  "companyName": "ABC Technologies Pvt Ltd",
                  "gstNumber": "09ABCDE1234F1Z5",
                  "message": "Bidder verified successfully against government records! Verification OTP sent to arnavtyagibhai@gmail.com"
                }
              }
            }
          },
          "409": { "description": "Email or GSTIN is already registered" },
          "400": { "description": "Invalid credentials or mismatch with government record" }
        }
      }
    },
    "/api/bidder/auth/verify-otp": {
      "post": {
        "tags": ["1. Commercial Bidder Authentication"],
        "summary": "Verify Email OTP & Finalize Registration",
        "description": "Validates the 6-digit OTP, creates the permanent Bidder record in PostgreSQL, and generates a JWT Bearer token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "arnavtyagibhai@gmail.com",
                "otp": "232551"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration finalized successfully and Bearer JWT token issued",
            "content": {
              "application/json": {
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiJ9...",
                  "type": "Bearer",
                  "bidderId": 1,
                  "email": "arnavtyagibhai@gmail.com",
                  "legalName": "Rahul Sharma",
                  "companyName": "ABC Technologies Pvt Ltd",
                  "phone": "9876543210",
                  "gstNumber": "09ABCDE1234F1Z5"
                }
              }
            }
          },
          "400": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/api/bidder/auth/resend-otp": {
      "post": {
        "tags": ["1. Commercial Bidder Authentication"],
