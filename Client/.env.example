# =============================================================================
# GemCompliance Backend API Configuration Example
# =============================================================================
# Enter your deployed backend server URL below (e.g. Render, Railway, Vercel, AWS):
# Examples:
#   VITE_BACKEND_URL=https://your-deployed-backend.onrender.com
#   BACKEND_URL=https://your-deployed-backend.onrender.com
#
# Note: Both VITE_BACKEND_URL and BACKEND_URL are supported.
# The app automatically normalizes slashes and appends /api as needed.
# =============================================================================

VITE_BACKEND_URL=https://your-deployed-backend.onrender.com
BACKEND_URL=https://your-deployed-backend.onrender.com
